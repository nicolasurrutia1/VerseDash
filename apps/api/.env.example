# Supabase PostgreSQL (recomendado)
# Copy from Dashboard → Project Settings → Database → Connection string
# IMPORTANT: if the password has @ # [ ] ! etc., URL-encode it (@ → %40, [ → %5B, ] → %5D, ! → %21)
#
# Transaction pooler (runtime / NestJS) — port 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
# Session pooler (Prisma migrate) — port 5432 (IPv4-friendly)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Local Docker fallback (optional):
# docker run -d --name versedash-postgres -e POSTGRES_PASSWORD=versedash -e POSTGRES_USER=postgres -e POSTGRES_DB=versedash -p 5432:5432 postgres:16-alpine
# DATABASE_URL="postgresql://postgres:versedash@127.0.0.1:5432/versedash"
# DIRECT_URL="postgresql://postgres:versedash@127.0.0.1:5432/versedash"

# App
PORT=3001
WEB_URL=http://localhost:3000
