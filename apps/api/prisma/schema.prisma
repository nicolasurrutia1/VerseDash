generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  nickname  String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("players")
}
