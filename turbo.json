{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["DATABASE_URL", "DIRECT_URL", "WEB_URL", "NEXT_PUBLIC_API_URL", "PORT", "VERCEL_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
